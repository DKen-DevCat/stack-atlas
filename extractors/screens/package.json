{
  "name": "@stack-atlas/extractor-screens",
  "version": "0.0.0",
  "private": true,
  "description": "Stack Atlas の screens 抽出器（ビルド成果物の HTML を route ごとに写し、許可リストで消毒して screens/ に置く）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stack-atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stack-atlas/core": "workspace:*",
    "@stack-atlas/extractor-nextjs-app": "workspace:*",
    "@stack-atlas/extractor-screenshots": "workspace:*"
  },
  "devDependencies": {
    "@stack-atlas/schema": "workspace:*",
    "playwright": "1.63.0"
  }
}
