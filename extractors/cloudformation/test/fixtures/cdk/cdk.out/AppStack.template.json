{
  "Resources": {
    "ItemsTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "items",
        "BillingMode": "PAY_PER_REQUEST"
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Items/Resource"
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "demo-site"
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Site/Bucket/Resource"
      }
    },
    "SiteBucketAutoDeleteObjectsCustomResource": {
      "Type": "Custom::S3AutoDeleteObjects",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": ["CustomS3AutoDeleteObjectsCustomResourceProviderHandler9D90184F", "Arn"]
        },
        "BucketName": {
          "Ref": "SiteBucket"
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Site/Bucket/AutoDeleteObjectsCustomResource/Default"
      }
    },
    "CustomS3AutoDeleteObjectsCustomResourceProviderHandler9D90184F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Handler": "index.handler",
        "Environment": {
          "Variables": {
            "B": {
              "Ref": "SiteBucket"
            }
          }
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Custom::S3AutoDeleteObjectsCustomResourceProvider/Handler"
      }
    },
    "ApiHandlerServiceRole1A2B3C4D": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {}
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Api/Handler/ServiceRole/Resource"
      }
    },
    "ApiHandler5E7490E8": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "ImageUri": {
            "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/api:latest"
          }
        },
        "PackageType": "Image",
        "Role": {
          "Fn::GetAtt": ["ApiHandlerServiceRole1A2B3C4D", "Arn"]
        },
        "Environment": {
          "Variables": {
            "TABLE": {
              "Ref": "ItemsTable"
            }
          }
        }
      },
      "DependsOn": ["ApiHandlerServiceRole1A2B3C4D"],
      "Metadata": {
        "aws:cdk:path": "AppStack/Api/Handler/Resource"
      }
    },
    "ApiHandlerFunctionUrl0C1D2E3F": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Fn::GetAtt": ["ApiHandler5E7490E8", "Arn"]
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Api/Handler/FunctionUrl/Resource"
      }
    },
    "IndexRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": "index-rewrite",
        "AutoPublish": true,
        "FunctionCode": "function handler(e){return e.request}",
        "FunctionConfig": {
          "Comment": "",
          "Runtime": "cloudfront-js-2.0"
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Site/IndexRewrite/Resource"
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Origins": [
            {
              "Id": "s3",
              "DomainName": {
                "Fn::GetAtt": ["SiteBucket", "RegionalDomainName"]
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": ["ApiHandlerFunctionUrl0C1D2E3F", "FunctionUrl"]
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "s3",
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7f88639e58f6",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": ["IndexRewrite", "FunctionARN"]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "api",
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad"
            }
          ]
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/Site/Distribution/Resource"
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "demo",
        "ProtocolType": "HTTP"
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/HttpApi/Resource"
      }
    },
    "HttpApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": ["ApiHandler5E7490E8", "Arn"]
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/HttpApi/Integration/Resource"
      }
    },
    "HttpApiGetItems": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /items",
        "Target": {
          "Fn::Join": [
            "",
            [
              "integrations/",
              {
                "Ref": "HttpApiIntegration"
              }
            ]
          ]
        }
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/HttpApi/GetItems/Resource"
      }
    },
    "CDKMetadata": {
      "Type": "AWS::CDK::Metadata",
      "Properties": {
        "Analytics": "v2:deflate64:xxx"
      },
      "Metadata": {
        "aws:cdk:path": "AppStack/CDKMetadata/Default"
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version"
    }
  }
}
