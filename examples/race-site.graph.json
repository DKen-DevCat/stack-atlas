      "name": "CloudFront",
      "file": "infra/stacks/cdn.ts",
      "code": "new CloudfrontDistribution(this, \"cdn\", {\n  origin: [nextLambdaOrigin, staticS3Origin],\n  defaultCacheBehavior: {\n    targetOriginId: \"next\",\n    cachePolicyId: honorOriginHeaders.id, // s-maxage に従う\n  },\n  orderedCacheBehavior: [\n    { pathPattern: \"/_next/static/*\", targetOriginId: \"s3\" },\n    { pathPattern: \"/admin/*\", cachePolicyId: CachingDisabled,\n      lambdaFunctionAssociation: [authEdge] },\n  ],\n});",
      "position": {
        "x": -11,
        "z": 0
      },
      "cache": {
        "tone": "ok",
        "badge": "CDN 4 behaviors",
        "rules": [
          {
            "key": "/_next/static/*",
            "value": "max-age=1年, immutable（S3）"
          },
          {
            "key": "/races/*",
            "value": "オリジンの s-maxage=60 に従う"
          },
          {
            "key": "/",
            "value": "s-maxage=30"
          },
          {
            "key": "/admin/*",
            "value": "CachingDisabled（素通し）"
          }
        ],
        "note": "キャッシュキーに Cookie を含めない設定にしておく（含めるとHIT率が崩壊）"
      }
    },
