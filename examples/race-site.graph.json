      "code": "// viewer-request（/admin/* のみ）\nexport const handler = async (e) => {\n  const req = e.Records[0].cf.request;\n  return (await verifyJwt(req)) ? req : redirect(\"/login\");\n};",
      "position": {
        "x": -11,
