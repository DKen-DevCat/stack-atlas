{
  "//": {
    "metadata": {
      "backend": "local",
      "stackName": "web",
      "version": "0.20.9"
    }
  },
  "terraform": {
    "backend": {
      "local": {
        "path": "${path.root}/terraform.web.tfstate"
      }
    },
    "required_providers": {
      "aws": {
        "source": "aws",
        "version": "5.67.0"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "ap-northeast-1"
      },
      {
        "alias": "us_east_1",
        "region": "us-east-1"
      }
    ]
  },
  "data": {
    "aws_iam_policy_document": {
      "apiTableAccess": {
        "//": {
          "metadata": {
            "path": "web/apiTableAccess",
            "uniqueId": "apiTableAccess"
          }
        },
        "statement": [
          {
            "actions": [
              "dynamodb:Query",
              "dynamodb:PutItem",
              "dynamodb:GetItem"
            ],
            "resources": [
              "${aws_dynamodb_table.racesTable.arn}"
            ]
          }
        ]
      }
    }
  },
  "resource": {
    "aws_dynamodb_table": {
      "racesTable": {
        "//": {
          "metadata": {
            "path": "web/racesTable",
            "uniqueId": "racesTable"
          }
        },
        "name": "race-results",
        "hash_key": "pk",
        "range_key": "sk",
        "billing_mode": "PAY_PER_REQUEST",
        "attribute": [
          {
            "name": "pk",
            "type": "S"
          },
          {
            "name": "sk",
            "type": "S"
          }
        ]
      }
    },
    "aws_cognito_user_pool": {
      "admins": {
        "//": {
          "metadata": {
            "path": "web/admins",
            "uniqueId": "admins"
          }
        },
        "name": "race-admins",
        "auto_verified_attributes": [
          "email"
        ]
      }
    },
    "aws_cognito_user_pool_client": {
      "adminsWebClient": {
        "//": {
          "metadata": {
            "path": "web/adminsWebClient",
            "uniqueId": "adminsWebClient"
          }
        },
        "name": "race-web",
        "user_pool_id": "${aws_cognito_user_pool.admins.id}",
        "generate_secret": false,
        "allowed_oauth_flows": [
          "code"
        ],
        "allowed_oauth_scopes": [
          "openid",
          "email"
        ],
        "callback_urls": [
          "https://races.example.com/login"
        ]
      }
    },
    "aws_iam_role": {
      "apiRole": {
        "//": {
          "metadata": {
            "path": "web/apiRole",
            "uniqueId": "apiRole"
          }
        },
        "name": "race-api",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "nextRole": {
        "//": {
          "metadata": {
            "path": "web/nextRole",
            "uniqueId": "nextRole"
          }
        },
        "name": "race-web",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "authEdgeRole": {
        "//": {
          "metadata": {
            "path": "web/authEdgeRole",
            "uniqueId": "authEdgeRole"
          }
        },
        "name": "race-auth-edge",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":[\"lambda.amazonaws.com\",\"edgelambda.amazonaws.com\"]},\"Action\":\"sts:AssumeRole\"}]}"
      }
    },
    "aws_iam_role_policy": {
      "apiRolePolicy": {
        "//": {
          "metadata": {
            "path": "web/apiRolePolicy",
            "uniqueId": "apiRolePolicy"
          }
        },
        "role": "${aws_iam_role.apiRole.id}",
        "policy": "${data.aws_iam_policy_document.apiTableAccess.json}"
      }
    },
    "aws_lambda_function": {
      "api": {
        "//": {
          "metadata": {
            "path": "web/api",
            "uniqueId": "api"
          }
        },
        "function_name": "race-api",
        "handler": "index.handler",
        "runtime": "nodejs20.x",
        "role": "${aws_iam_role.apiRole.arn}",
        "filename": "../apps/api/dist/index.zip",
        "environment": {
          "variables": {
            "TABLE": "${aws_dynamodb_table.racesTable.name}"
          }
        }
      },
      "next": {
        "//": {
          "metadata": {
            "path": "web/next",
            "uniqueId": "next"
          }
        },
        "function_name": "race-web",
        "handler": "run.sh",
        "runtime": "nodejs20.x",
        "memory_size": 1024,
        "timeout": 30,
        "role": "${aws_iam_role.nextRole.arn}",
        "filename": "../apps/web/.next/standalone.zip",
        "layers": [
          "arn:aws:lambda:ap-northeast-1:753240598075:layer:LambdaAdapterLayerX86:24"
        ],
        "environment": {
          "variables": {
            "AWS_LAMBDA_EXEC_WRAPPER": "/opt/bootstrap",
            "PORT": "3000",
            "API_BASE_URL": "${aws_apigatewayv2_api.httpApi.api_endpoint}"
          }
        }
      },
      "authEdge": {
        "//": {
          "metadata": {
            "path": "web/authEdge",
            "uniqueId": "authEdge"
          }
        },
        "provider": "aws.us_east_1",
        "function_name": "race-auth-edge",
        "handler": "auth.handler",
        "runtime": "nodejs20.x",
        "role": "${aws_iam_role.authEdgeRole.arn}",
        "publish": true,
        "filename": "../infra/edge/auth.zip",
        "tags": {
          "UserPoolId": "${aws_cognito_user_pool.admins.id}"
        }
      }
    },
    "aws_lambda_function_url": {
      "nextUrl": {
        "//": {
          "metadata": {
            "path": "web/nextUrl",
            "uniqueId": "nextUrl"
          }
        },
        "function_name": "${aws_lambda_function.next.function_name}",
        "authorization_type": "NONE"
      }
    },
    "aws_apigatewayv2_api": {
      "httpApi": {
        "//": {
          "metadata": {
            "path": "web/httpApi",
            "uniqueId": "httpApi"
          }
        },
        "name": "race-api",
        "protocol_type": "HTTP"
      }
    },
    "aws_apigatewayv2_stage": {
      "httpApiDefault": {
        "//": {
          "metadata": {
            "path": "web/httpApiDefault",
            "uniqueId": "httpApiDefault"
          }
        },
        "api_id": "${aws_apigatewayv2_api.httpApi.id}",
        "name": "$default",
        "auto_deploy": true
      }
    },
    "aws_apigatewayv2_integration": {
      "apiIntegration": {
        "//": {
          "metadata": {
            "path": "web/apiIntegration",
            "uniqueId": "apiIntegration"
          }
        },
        "api_id": "${aws_apigatewayv2_api.httpApi.id}",
        "integration_type": "AWS_PROXY",
        "integration_uri": "${aws_lambda_function.api.invoke_arn}",
        "payload_format_version": "2.0"
      }
    },
    "aws_apigatewayv2_route": {
      "getRaces": {
        "//": {
          "metadata": {
            "path": "web/getRaces",
            "uniqueId": "getRaces"
          }
        },
        "api_id": "${aws_apigatewayv2_api.httpApi.id}",
        "route_key": "GET /races/{id}",
        "target": "integrations/${aws_apigatewayv2_integration.apiIntegration.id}"
      },
      "listRaces": {
        "//": {
          "metadata": {
            "path": "web/listRaces",
            "uniqueId": "listRaces"
          }
        },
        "api_id": "${aws_apigatewayv2_api.httpApi.id}",
        "route_key": "GET /races",
        "target": "integrations/${aws_apigatewayv2_integration.apiIntegration.id}"
      },
      "postResult": {
        "//": {
          "metadata": {
            "path": "web/postResult",
            "uniqueId": "postResult"
          }
        },
        "api_id": "${aws_apigatewayv2_api.httpApi.id}",
        "route_key": "POST /results",
        "target": "integrations/${aws_apigatewayv2_integration.apiIntegration.id}"
      }
    },
    "aws_lambda_permission": {
      "apiInvoke": {
        "//": {
          "metadata": {
            "path": "web/apiInvoke",
            "uniqueId": "apiInvoke"
          }
        },
        "statement_id": "AllowHttpApiInvoke",
        "action": "lambda:InvokeFunction",
        "function_name": "${aws_lambda_function.api.function_name}",
        "principal": "apigateway.amazonaws.com",
        "source_arn": "${aws_apigatewayv2_api.httpApi.execution_arn}/*/*"
      }
    },
    "aws_s3_bucket": {
      "static": {
        "//": {
          "metadata": {
            "path": "web/static",
            "uniqueId": "static"
          }
        },
        "bucket": "race-web-static"
      }
    },
    "aws_cloudfront_cache_policy": {
      "honorOriginHeaders": {
        "//": {
          "metadata": {
            "path": "web/honorOriginHeaders",
            "uniqueId": "honorOriginHeaders"
          }
        },
        "name": "race-honor-origin",
        "min_ttl": 0,
        "default_ttl": 60,
        "max_ttl": 300,
        "parameters_in_cache_key_and_forwarded_to_origin": {
          "cookies_config": {
            "cookie_behavior": "none"
          },
          "headers_config": {
            "header_behavior": "none"
          },
          "query_strings_config": {
            "query_string_behavior": "none"
          },
          "enable_accept_encoding_gzip": true
        }
      }
    },
    "aws_cloudfront_distribution": {
      "cdn": {
        "//": {
          "metadata": {
            "path": "web/cdn",
            "uniqueId": "cdn"
          }
        },
        "enabled": true,
        "aliases": [
          "races.example.com"
        ],
        "origin": [
          {
            "origin_id": "nextOrigin",
            "domain_name": "${element(split(\"/\", aws_lambda_function_url.nextUrl.function_url), 2)}",
            "custom_origin_config": {
              "http_port": 80,
              "https_port": 443,
              "origin_protocol_policy": "https-only",
              "origin_ssl_protocols": [
                "TLSv1.2"
              ]
            }
          },
          {
            "origin_id": "staticOrigin",
            "domain_name": "${aws_s3_bucket.static.bucket_regional_domain_name}"
          }
        ],
        "default_cache_behavior": {
          "viewer_protocol_policy": "redirect-to-https",
          "cached_methods": [
            "GET",
            "HEAD"
          ],
          "target_origin_id": "nextOrigin",
          "allowed_methods": [
            "GET",
            "HEAD",
            "OPTIONS",
            "PUT",
            "POST",
            "PATCH",
            "DELETE"
          ],
          "cache_policy_id": "${aws_cloudfront_cache_policy.honorOriginHeaders.id}"
        },
        "ordered_cache_behavior": [
          {
            "viewer_protocol_policy": "redirect-to-https",
            "cached_methods": [
              "GET",
              "HEAD"
            ],
            "path_pattern": "/_next/static/*",
            "target_origin_id": "staticOrigin",
            "allowed_methods": [
              "GET",
              "HEAD"
            ],
            "cache_policy_id": "658327ea-f89d-4fab-a63d-7f88639e58f6"
          },
          {
            "viewer_protocol_policy": "redirect-to-https",
            "cached_methods": [
              "GET",
              "HEAD"
            ],
            "path_pattern": "/races/*",
            "target_origin_id": "nextOrigin",
            "allowed_methods": [
              "GET",
              "HEAD"
            ],
            "cache_policy_id": "${aws_cloudfront_cache_policy.honorOriginHeaders.id}"
          },
          {
            "viewer_protocol_policy": "redirect-to-https",
            "cached_methods": [
              "GET",
              "HEAD"
            ],
            "path_pattern": "/",
            "target_origin_id": "nextOrigin",
            "allowed_methods": [
              "GET",
              "HEAD"
            ],
            "cache_policy_id": "${aws_cloudfront_cache_policy.honorOriginHeaders.id}"
          },
          {
            "viewer_protocol_policy": "redirect-to-https",
            "cached_methods": [
              "GET",
              "HEAD"
            ],
            "path_pattern": "/admin/*",
            "target_origin_id": "nextOrigin",
            "allowed_methods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "cache_policy_id": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "lambda_function_association": [
              {
                "event_type": "viewer-request",
                "lambda_arn": "${aws_lambda_function.authEdge.qualified_arn}"
              }
            ]
          }
        ],
        "restrictions": {
          "geo_restriction": {
            "restriction_type": "none"
          }
        },
        "viewer_certificate": {
          "cloudfront_default_certificate": true
        }
      }
    }
  }
}
