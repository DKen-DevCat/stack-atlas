{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stack-atlas/graph.schema.json",
  "title": "Stack Atlas graph",
  "description": "抽出器（extractor）が出力し、ビューアが読み込む共通フォーマット。詳細は docs/03-graph-schema.md。",
  "type": "object",
  "required": ["version", "layers", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "repo": { "type": "string", "description": "リポジトリURLやパス" },
        "commit": { "type": "string", "description": "抽出時のコミットSHA" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "description": "上から順（index 0 が最上段）。",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "source": { "type": "string", "description": "この層の出どころ（ディレクトリやツール名）。表示用" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/flow" }
    },
    "kinds": {
      "type": "object",
      "description": "ノード kind の表示定義（任意）。ビューアの既定の kind 表に上書き・追加される",
      "additionalProperties": { "$ref": "#/$defs/kindDefinition" }
    }
  },
  "$defs": {
    "kindDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "表示名（日本語）" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "size": {
          "type": "array",
          "description": "ボックスの大きさ [x, y, z]",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "layer": { "type": "string", "description": "この kind の既定の層（layers[].id）。抽出時に使う" }
      }
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z]+:.+$",
      "description": "<kind接頭辞>:<識別子>。例 infra:lambdaNext, route:/races/[id], comp:ResultTable, type:Race"
    },
    "node": {
      "type": "object",
      "required": ["id", "layer", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "layer": { "type": "string", "description": "layers[].id" },
        "kind": {
          "type": "string",
          "description": "表示形状と色を決める。未知の kind はビューアが汎用ボックスで描く",
          "anyOf": [
            { "enum": ["actor", "infra", "layout", "page", "component", "hook", "lib", "type", "schema", "handler", "endpoint", "queue", "db", "cron", "service"] },
            { "type": "string" }
          ]
        },
        "name": { "type": "string" },
        "file": { "type": "string", "description": "リポジトリルートからの相対パス" },
        "line": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "description": "パネルに出すコード抜粋" },
        "position": {
          "type": "object",
          "description": "層の平面上の手動配置。省略時はビューアが自動レイアウト",
          "required": ["x", "z"],
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "z": { "type": "number" } }
        },
        "cache": { "$ref": "#/$defs/cache" },
        "screen": { "$ref": "#/$defs/screen" },
        "meta": { "type": "object", "additionalProperties": true, "description": "抽出器固有の追加情報（リソース型、construct path など）" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "$ref": "#/$defs/nodeId" },
        "kind": {
          "type": "string",
          "description": "flow=インフラ間のリクエスト経路 / deploy=インフラ上に載っている中身 / uses=import・型参照 / http=HTTP呼び出し / schema=DBとスキーマ型",
          "anyOf": [
            { "enum": ["flow", "deploy", "uses", "http", "schema"] },
            { "type": "string" }
          ]
        },
        "label": { "type": "string" }
      }
    },
    "cache": {
      "type": "object",
      "required": ["tone", "badge"],
      "additionalProperties": false,
      "properties": {
        "tone": { "enum": ["ok", "warn", "off", "info"], "description": "ok=効いている / warn=要注意 / off=なし / info=補足" },
        "badge": { "type": "string", "description": "ラベル横に出す短い文字列" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
          }
        },
        "note": { "type": "string", "description": "注意点。パネルに⚠付きで出る" }
      }
    },
    "screen": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "html": { "type": "string", "description": "graph.json からの相対パス。消毒したビルド成果物の HTML（script 無し。docs/18 §3.3）" },
        "source": {
          "enum": ["next-export", "next-build", "dir", "wireframe", "screenshot"],
          "description": "html の出どころ（v2 の screen.source と同じ語彙）"
        },
        "screenshot": { "type": "string", "description": "graph.json からの相対パス（PNG/JPEG）。html と両方あれば html を優先。どちらも無ければプレースホルダ表示" },
        "width": { "type": "integer", "description": "regions 座標系の幅（スクショのpx幅。html のときはビューポート）" },
        "height": { "type": "integer" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "x", "y", "w", "h"],
            "additionalProperties": false,
            "properties": {
              "ref": { "$ref": "#/$defs/nodeId", "description": "この領域を描画しているノード（通常 comp:*）" },
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number" }, "h": { "type": "number" },
              "source": {
                "enum": ["screenshot", "yaml"],
                "description": "領域の出どころ。省略時は screenshot（スクショで測った値）。yaml は .stack-atlas/screens/<slug>.regions.yaml で補った値（docs/19 §3.7。HTML の計測が勝つ）"
              }
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tone": { "enum": ["default", "cache-hit"], "description": "cache-hit は黄色で描く" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["node", "text"],
            "additionalProperties": false,
            "properties": {
              "node": { "$ref": "#/$defs/nodeId" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
