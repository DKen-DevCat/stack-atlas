{
  "name": "@stack-atlas/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Stack Atlas の graph.json の型・JSON Schema・検証",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stack-atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph.schema.json": "./graph.schema.json",
    "./graph-v2.schema.json": "./graph-v2.schema.json"
  },
  "bin": {
    "stack-atlas-validate": "./bin/stack-atlas-validate.js"
  },
  "files": [
    "bin",
    "dist",
    "graph.schema.json",
    "graph-v2.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
