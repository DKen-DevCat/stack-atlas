  "behaviors": [
    {
      "id": "open",
      "name": "画面を開く",
      "screen": "screen:/",
      "trigger": {
        "action": "open"
      },
      "steps": [
        {
          "send": [
            {
              "from": "screen:/#out/open",
              "to": "fn:load#in/call"
            }
          ],
          "say": "Service Worker（sw.js）を登録し、それがこの画面の通信を受け取るようになるのを待ってから、load を呼ぶ"
        },
        {
          "send": [
            {
              "from": "fn:load#out/request",
              "to": "endpoint:GET /api/comments#in/request"
            }
          ],
          "back": [
            {
              "from": "endpoint:GET /api/comments#out/body.comments",
              "to": "fn:load#in/comments"
            }
          ]
        },
        {
          "send": [
