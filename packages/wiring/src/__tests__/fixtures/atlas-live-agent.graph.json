              "to": "endpoint:GET /api/comments#res/rows"
            }
          ]
        },
        {
          "send": [
            {
              "from": "fn:load#out/comments",
              "to": "fn:render#in/comments"
            }
          ]
        },
        {
          "send": [
            {
              "from": "fn:render#out/count",
              "to": "part:status#in/count"
            }
          ],
          "say": "「読みこみ中…」を「N 件のコメント」に書き換える"
        },
        {
          "send": [
            {
              "from": "fn:render#out/comments",
              "to": "part:comment-list#in/comments"
            }
          ],
          "say": "一覧を丸ごと描き直す。author が me のコメントの行にだけ、削除ボタンを付ける"
        }
      ],
      "result": {
        "say": "コメントの件数と、コメントの一覧が出る。",
        "part": "comment-list"
      }
    },
    {
      "id": "post-comment",
      "name": "コメントを投稿する",
      "screen": "screen:/",
      "trigger": {
        "action": "submit",
        "part": "comment-form"
      },
      "steps": [
        {
          "send": [
            {
              "from": "part:comment-form#out/comment",
              "to": "endpoint:POST /api/comments#in/body.comment"
            }
          ],
          "back": [
            {
              "from": "endpoint:POST /api/comments#out/body.comment",
              "to": "part:comment-form#in/saved"
            }
          ],
          "say": "入力の前後の空白を除いて送る。返事（201）の中身は、画面では使わない"
        },
        {
          "send": [
            {
              "from": "endpoint:POST /api/comments#req/row",
              "to": "table:comments#write/row"
            }
          ],
          "say": "id を振り、body を 500 文字までに切り、author を me にして、配列の先頭に足す"
        },
        {
          "send": [
            {
              "from": "part:comment-form#out/reload",
              "to": "fn:load#in/call"
            }
          ],
          "say": "返事を待ってから、入力欄を空にして、load を呼ぶ"
        },
        {
          "send": [
            {
              "from": "fn:load#out/request",
              "to": "endpoint:GET /api/comments#in/request"
            }
          ],
          "back": [
            {
              "from": "endpoint:GET /api/comments#out/body.comments",
              "to": "fn:load#in/comments"
            }
          ]
        },
        {
          "send": [
            {
              "from": "endpoint:GET /api/comments#req/all",
              "to": "table:comments#key/all"
            }
          ],
          "back": [
            {
              "from": "table:comments#read/rows",
              "to": "endpoint:GET /api/comments#res/rows"
            }
          ]
        },
        {
          "send": [
            {
              "from": "fn:load#out/comments",
              "to": "fn:render#in/comments"
            }
          ]
        },
        {
          "send": [
            {
              "from": "fn:render#out/count",
              "to": "part:status#in/count"
            }
          ]
        },
        {
          "send": [
            {
              "from": "fn:render#out/comments",
              "to": "part:comment-list#in/comments"
            }
          ]
        }
      ],
      "result": {
        "say": "入力欄が空になり、一覧の先頭に自分のコメントが増え、件数が 1 つ増える。",
        "part": "comment-list"
      },
      "when": {
        "part:comment-form#filled": true
      }
    },
