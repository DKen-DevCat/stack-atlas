{
  "name": "@stack-atlas/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Stack Atlas のビューア（graph.json v1 は 3D の地図、v2 は配線図。静的アプリ）",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync-samples.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-samples.mjs",
    "build": "vite build && vite build --config vite.live.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "build:live": "vite build --config vite.live.config.ts"
  },
  "dependencies": {
    "@stack-atlas/schema": "workspace:*",
    "@stack-atlas/wiring": "workspace:*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.187.0",
    "vite": "^8.3.6"
  }
}
