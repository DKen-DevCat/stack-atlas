{
  "name": "@stack-atlas/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Stack Atlas の CLI（build / validate / serve / diff）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stack-atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stack-atlas": "./bin/stack-atlas.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stack-atlas/core": "workspace:*",
    "@stack-atlas/extractor-api-link": "workspace:*",
    "@stack-atlas/extractor-cache": "workspace:*",
    "@stack-atlas/extractor-cdktf": "workspace:*",
    "@stack-atlas/extractor-cloudformation": "workspace:*",
    "@stack-atlas/extractor-files": "workspace:*",
    "@stack-atlas/extractor-go": "workspace:*",
    "@stack-atlas/extractor-go-types": "workspace:*",
    "@stack-atlas/extractor-nextjs-app": "workspace:*",
    "@stack-atlas/extractor-openapi": "workspace:*",
    "@stack-atlas/extractor-screenshots": "workspace:*",
    "@stack-atlas/extractor-sql": "workspace:*",
    "@stack-atlas/extractor-terraform": "workspace:*",
    "@stack-atlas/extractor-ts-imports": "workspace:*",
    "@stack-atlas/extractor-ts-types": "workspace:*",
    "@stack-atlas/schema": "workspace:*"
  },
  "devDependencies": {
    "@stack-atlas/wiring": "workspace:*"
  }
}
